# ==============================================================================
# Enterprise Knowledge AI Assistant - Server Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for Phase 4 Grounded Answer Generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
# Recommended: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Grounding Guardrail: Minimum Cosine Similarity Cutoff (0.0 to 1.0)
# Default is 0.35; queries below this threshold are stopped before LLM invocation
RAG_RELEVANCE_THRESHOLD=0.35

# Input Guardrail: Maximum Allowed User Input Length (chars)
MAX_INPUT_LENGTH=2000
