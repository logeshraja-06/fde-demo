# ==============================================================================
# Enterprise Knowledge AI Assistant - Environment Configuration Example
# ==============================================================================

# Google Gemini API Key (Optional: system provides deterministic grounded fallback when absent)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Configurable Gemini Model Name (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Grounding Guardrail: Minimum Cosine Similarity Cutoff (0.0 to 1.0, Default: 0.35)
RAG_RELEVANCE_THRESHOLD=0.35

# Input Guardrail: Maximum Allowed User Input Length in characters (Default: 2000)
MAX_INPUT_LENGTH=2000
