# ==========================================
# TruthGuard — Environment Configuration
# ==========================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database Configuration (PostgreSQL + pgvector)
# When running with Docker Compose:
DATABASE_URL=postgresql+psycopg://truthguard:truthguard@localhost:5432/truthguard

# Local Fallback (automatically active if PostgreSQL is unavailable)
ALLOW_LOCAL_FALLBACK=true

# Chunking & RAG Parameters
TARGET_CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=5
MAX_RETRIEVAL_RETRIES=2
